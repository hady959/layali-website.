# ==========================================
# Server Configuration (Railway auto-sets PORT)
# ==========================================
PORT=3000
NODE_ENV=production

# Public URL (e.g., https://layali.up.railway.app or custom domain)
PUBLIC_URL=

# ==========================================
# Cloud Database (PostgreSQL / Railway Postgres / Supabase)
# ==========================================
# When provided, Layali uses cloud PostgreSQL. If omitted, it falls back to local SQLite.
DATABASE_URL=

# ==========================================
# Cloud Storage (Supabase Storage)
# ==========================================
# When provided, all uploaded images, audio, and videos are stored permanently in Supabase Cloud Storage.
# Use the backend Secret Key (service_role) for administrative storage uploads (bypasses RLS).
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Legacy alias for SUPABASE_SECRET_KEY:
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=layali-uploads

# Storage path for local fallback mode
UPLOAD_DIR=./uploads

# ==========================================
# Security & Access Passwords
# ==========================================
AUTH_SECRET=layali_romantic_secret_key_2026

# Main Recipient Gate Password (Day, Month, Year)
PASS_DAY=16
PASS_MONTH=8
PASS_YEAR=2026

# Admin Dashboard Password (Day, Month, Year)
ADMIN_PASS_DAY=11
ADMIN_PASS_MONTH=1
ADMIN_PASS_YEAR=1111

# Optional Gemini AI API Key
GEMINI_API_KEY=

